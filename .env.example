# ==============================================================================
# SQL SERVER CONFIGURATION
# ==============================================================================
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=server name
DB_PORT=port number
DB_NAME=database name
DB_TABLE=table name
DB_USER=your username
DB_PASSWORD=your password

# Incremental Sync Configuration
# Primary key or incrementing column (e.g., id, product_id)
DB_PRIMARY_KEY= column name
# Timestamp column for tracking modified records (e.g., updated_at, last_modified)
DB_TIMESTAMP_COL= column name

# ==============================================================================
# ELASTICSEARCH CONFIGURATION
# ==============================================================================
ES_HOST= local host url
ES_INDEX=index name
ES_USER=username
ES_PASSWORD=password here
ES_API_KEY= API KEY (optional)
ES_BATCH_SIZE= batch size for inserting into elastic search

# Sync Checkpoint File
STATE_FILE= file name for inserting sync data (useful for using incremental loading)